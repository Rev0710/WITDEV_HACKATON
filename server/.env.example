PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/stayflow
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGINS=http://localhost:5173
CLIENT_APP_URL=http://localhost:5173
NODE_ENV=development

# Email password reset (SMTP with TLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional SMS password reset through Twilio; phone numbers must use E.164 format
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
